# ============================================
# CONTRACTS DEPLOYMENT CONFIGURATION
# ============================================

# Your private key for deploying contracts (WITHOUT 0x prefix)
# IMPORTANT: Never commit your actual private key to git!
# Get this from your wallet (MetaMask, etc.)
PRIVATE_KEY=your_private_key_here

# Optional: Etherscan API key for contract verification
# Get from: https://etherscan.io/myapikey (or equivalent for U2U if available)
ETHERSCAN_API_KEY=your_etherscan_api_key_here
