# ============================================
# FRONTEND CONFIGURATION FOR DAOTOWN
# ============================================

# ===== DEPLOYED CONTRACT ADDRESSES =====
# After deploying contracts using Foundry, update these with the deployed addresses
# You'll get these addresses after running: make deploy ARGS="--network u2u_testnet"

# DAOManager contract address (from contracts/src/DAOManager.sol)
NEXT_PUBLIC_DAOMANAGER_ADDRESS=0x...

# CreateGovernanceToken contract address (from contracts/src/CreateGovernanceToken.sol)
NEXT_PUBLIC_CREATE_GOVERNANACE_ADDRESS=0x...

# ===== NETWORK CONFIGURATION =====
# RPC URL for U2U Network (already configured in wagmiprovider.tsx)
# Testnet: https://rpc-nebulas-testnet.u2u.xyz
# Mainnet: https://rpc-mainnet.u2u.xyz
NEXT_PUBLIC_RPC_URL=https://rpc-nebulas-testnet.u2u.xyz

# ===== IPFS / LIGHTHOUSE STORAGE =====
# Lighthouse API Key for IPFS file uploads
# Get from: https://files.lighthouse.storage/
# 1. Sign up at https://files.lighthouse.storage/
# 2. Go to API Keys section
# 3. Generate a new API key
NEXT_PUBLIC_LIGHTHOUSE_API_KEY=your_lighthouse_api_key_here

# ===== DISCORD INTEGRATION (Optional) =====
# Discord Bot Configuration for DAO channels
# Get from: https://discord.com/developers/applications
# 1. Create a new application
# 2. Go to Bot section and create a bot
# 3. Copy the Bot Token
# 4. Enable necessary intents (Server Members, Message Content)

# Discord Guild (Server) ID where DAO channels will be created
NEXT_PUBLIC_DISCORD_GUILD_ID=your_discord_guild_id

# Discord Bot ID
NEXT_PUBLIC_BOT_ID=your_discord_bot_id

# Discord Bot Token (used in API routes - keep secure!)
DISCORD_BOT_TOKEN=your_discord_bot_token

# ===== NEXT AUTH (Optional - for Discord OAuth) =====
# NextAuth configuration if using Discord authentication
# Get from: https://discord.com/developers/applications
# 1. Go to OAuth2 section
# 2. Copy Client ID and Client Secret
# 3. Add redirect URL: http://localhost:3000/api/auth/callback/discord

NEXTAUTH_URL=http://localhost:3000
# Generate a secure random string for NEXTAUTH_SECRET
# Run: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here_or_run_openssl_rand_base64_32
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret